# ==============================================================================
# OASIS STORE — PLANTILLA DE VARIABLES DE ENTORNO (.env.example)
# ==============================================================================
# Copia este archivo a `.env` (`cp .env.example .env`) o ejecuta `./deploy.sh`
# para generar contraseñas y firmas HMAC aleatorias automáticamente.

# --- Interfaz de Red y URL de la Tienda ---
BIND_IP="127.0.0.1"
APP_PORT=8085
APP_NAME="OasisStore"
APP_ENV="production"
APP_DEBUG="false"
APP_URL="http://localhost:8085"

# --- Base de Datos (MariaDB 11.4 LTS) ---
DB_DATABASE="oasis_paymenter"
DB_USERNAME="oasis_user"
DB_PASSWORD="aqui_pon_tu_password_db"
DB_ROOT_PASSWORD="aqui_pon_tu_password_root_db"

# --- Firma Criptográfica Webhook Interno (HMAC-SHA256, mín. 32 caracteres) ---
WEBHOOK_SECRET="aqui_pon_tu_llave_secreta_hmac_min_32_caracteres"

# --- Alertas Opcionales de Nuevas Órdenes (Discord / Telegram) ---
DISCORD_WEBHOOK_URL=""
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# --- Integración con Orquestador / Gateway de Notificaciones Interno ---
ARTURO_API_URL="http://tu-orquestador-interno:3000"
ARTURO_API_KEY="aqui_pon_tu_llave_api"
ARTURO_VAULT_FOLDER="OPERACIONES/OasisStore"
ARTURO_LOG_TO_VAULT="true"

# --- Scraper de Catálogo (Opcional: URL objetivo para sincronización) ---
TARGET_STORE_URL="https://tu-catalogo-origen.example.com"

# --- Cloudflare Tunnel (Opcional) ---
TUNNEL_TOKEN="aqui_pon_tu_token_cloudflared_opcional"
